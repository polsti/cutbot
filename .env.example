# Telegram bot token from @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# Supabase/Postgres connection string (asyncpg driver)
# Get this from Supabase project settings -> Database -> Connection string
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

# Gemini API key for meal-photo recognition, from aistudio.google.com/apikey
GEMINI_API_KEY=AQ.your-key-here
